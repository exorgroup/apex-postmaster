# APEX PostMaster Environment Configuration
# Copy this file to .env and fill in your values

# Application
APP_ENV=production
APP_DEBUG=false
APP_URL=https://yourdomain.com

# Database
DB_HOST=localhost
DB_NAME=apex_postmaster
DB_USER=your_db_user
DB_PASS=your_db_password

# JWT Secret (generate a random 64+ character string)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Google/YouTube OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Facebook/Instagram OAuth (Business App - for connecting pages/Instagram)
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret

# Facebook Login (Consumer App - for user authentication)
FACEBOOK_LOGIN_APP_ID=your-facebook-login-app-id
FACEBOOK_LOGIN_APP_SECRET=your-facebook-login-app-secret

# Claude AI API
CLAUDE_API_KEY=your-claude-api-key

# Stripe
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PRICE_PRO=price_your_pro_price_id
STRIPE_PRICE_TEAM=price_your_team_price_id

# Plan Prices (in EUR, displayed on pricing page)
PLAN_PRO_PRICE=15
PLAN_TEAM_PRICE=39

# Contact Form
CONTACT_EMAIL=your-contact-email@example.com

# Plan Limits
# Use -1 for unlimited, 0 for feature not available

# FREE Plan - €0
PLAN_FREE_PRICE_MONTHLY=0
PLAN_FREE_PRICE_ANNUAL=0
PLAN_FREE_POSTS_PER_MONTH=15
PLAN_FREE_CONNECTIONS=2
PLAN_FREE_AI_GENERATIONS=10
PLAN_FREE_AI_CREDITS_MONTHLY=0
PLAN_FREE_ANALYTICS_DAYS=7
PLAN_FREE_STREAMS=0
PLAN_FREE_TEAM_MEMBERS=1
PLAN_FREE_BULK_IMPORT=false
PLAN_FREE_RECYCLING=false
PLAN_FREE_APPROVAL=false

# CREATOR Plan - €20/month or €192/year (€16/month)
PLAN_CREATOR_PRICE_MONTHLY=2000
PLAN_CREATOR_PRICE_ANNUAL=19200
PLAN_CREATOR_POSTS_PER_MONTH=-1
PLAN_CREATOR_CONNECTIONS=3
PLAN_CREATOR_AI_GENERATIONS=50
PLAN_CREATOR_AI_CREDITS_MONTHLY=200
PLAN_CREATOR_ANALYTICS_DAYS=30
PLAN_CREATOR_STREAMS=0
PLAN_CREATOR_TEAM_MEMBERS=1
PLAN_CREATOR_BULK_IMPORT=false
PLAN_CREATOR_RECYCLING=false
PLAN_CREATOR_APPROVAL=false

# PRO Plan - €39/month or €374/year (€31.17/month)
PLAN_PRO_PRICE_MONTHLY=3900
PLAN_PRO_PRICE_ANNUAL=37400
PLAN_PRO_POSTS_PER_MONTH=-1
PLAN_PRO_CONNECTIONS=8
PLAN_PRO_AI_GENERATIONS=200
PLAN_PRO_AI_CREDITS_MONTHLY=500
PLAN_PRO_ANALYTICS_DAYS=90
PLAN_PRO_STREAMS=5
PLAN_PRO_TEAM_MEMBERS=1
PLAN_PRO_BULK_IMPORT=true
PLAN_PRO_RECYCLING=true
PLAN_PRO_APPROVAL=false

# TEAM Plan - €98/month or €940/year (€78.33/month)
PLAN_TEAM_PRICE_MONTHLY=9800
PLAN_TEAM_PRICE_ANNUAL=94000
PLAN_TEAM_POSTS_PER_MONTH=-1
PLAN_TEAM_CONNECTIONS=20
PLAN_TEAM_AI_GENERATIONS=500
PLAN_TEAM_AI_CREDITS_MONTHLY=1000
PLAN_TEAM_ANALYTICS_DAYS=365
PLAN_TEAM_STREAMS=20
PLAN_TEAM_TEAM_MEMBERS=5
PLAN_TEAM_BULK_IMPORT=true
PLAN_TEAM_RECYCLING=true
PLAN_TEAM_APPROVAL=true

# AGENCY Plan - €193/month or €1852/year (€154.33/month)
PLAN_AGENCY_PRICE_MONTHLY=19300
PLAN_AGENCY_PRICE_ANNUAL=185200
PLAN_AGENCY_POSTS_PER_MONTH=-1
PLAN_AGENCY_CONNECTIONS=50
PLAN_AGENCY_AI_GENERATIONS=1000
PLAN_AGENCY_AI_CREDITS_MONTHLY=2500
PLAN_AGENCY_ANALYTICS_DAYS=-1
PLAN_AGENCY_STREAMS=50
PLAN_AGENCY_TEAM_MEMBERS=15
PLAN_AGENCY_BULK_IMPORT=true
PLAN_AGENCY_RECYCLING=true
PLAN_AGENCY_APPROVAL=true

# AI Credit Packages (one-time purchases, separate from plan)
CREDIT_STARTER_PRICE=1000
CREDIT_STARTER_AMOUNT=1000
CREDIT_STARTER_BONUS=0
CREDIT_BUILDER_PRICE=2500
CREDIT_BUILDER_AMOUNT=2500
CREDIT_BUILDER_BONUS=200
CREDIT_GROWTH_PRICE=5000
CREDIT_GROWTH_AMOUNT=5000
CREDIT_GROWTH_BONUS=500
CREDIT_SCALE_PRICE=10000
CREDIT_SCALE_AMOUNT=10000
CREDIT_SCALE_BONUS=1500

# Monthly AI credits expire at end of billing period
AI_CREDITS_MONTHLY_EXPIRE=true

# Annual discount is roughly 20% (2 months free)
ANNUAL_BILLING_ENABLED=true